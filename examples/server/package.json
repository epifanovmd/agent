{
  "name": "example-server",
  "version": "1.3.1",
  "private": true,
  "description": "Сервер стенда на agent-sdk/server: HTTP API над Agents и сквозные тесты с настоящим агентом",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "e2e": "node --import tsx --test --test-timeout=300000 e2e/*.test.ts"
  },
  "dependencies": {
    "agent-sdk": "file:../../sdk/node",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1"
  }
}
