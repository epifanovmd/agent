{{- /*
Файл настроек агента с пояснениями (agent init, agent install). Ex — «# » перед примером
(или пусто: проверка, что примеры — верный YAML); D — настройки по умолчанию, L — жизнь
воркера по умолчанию; quote — значение YAML, dur — длительность (10m, 1h).
*/ -}}
# Настройки агента. Описание всех ключей — docs/ARCHITECTURE.md, раздел «Настройки»:
# https://github.com/epifanovmd/agent/blob/main/docs/ARCHITECTURE.md#настройки
#
# Обязательно только server.url, остальное можно не задавать. Строки с «#» — пояснения
# и примеры; у настроек со значением по умолчанию в примере стоит оно само.
# Чтобы поменять настройку, уберите «#» и впишите своё значение.
# ${ИМЯ} в значении подставляется из окружения. Переменные AGENT_* важнее файла:
# AGENT_SERVER_URL, AGENT_ENROLL_TOKEN, AGENT_NAME, AGENT_DATA_DIR и другие.
# Проверить файл: agent config check. Применить без перезапуска (служба): systemctl reload agent.

# Файл поверх другого: сначала читается extends, затем этот (словари сливаются, списки
# заменяются, воркеры — по имени). envFiles — файлы KEY=VALUE для ${ИМЯ} и AGENT_*;
# окружение важнее их. Пути — от этого файла.
{{ .Ex }}extends: agent.yaml
{{ .Ex }}envFiles: [.env]

# Для agent install (флаги важнее): экземпляр на узле и параметры установки.
{{ .Ex }}instance: example
{{ .Ex }}install:
{{ .Ex }}  packages: [python3]
{{ .Ex }}  sysctl: { net.ipv4.ping_group_range: "0 2147483647" }

# Адрес бэкенда.
server:
{{- if .ServerURL }}
  url: {{ quote .ServerURL }}
{{- else }}
  {{ .Ex }}url: https://api.example.com
{{- end }}
  # Ещё адреса того же бэкенда: если первый недоступен, агент подключится к следующему.
  {{ .Ex }}urls: [https://api-2.example.com]
  # Свой корневой сертификат сервера (PEM) — в дополнение к системным.
{{- if .CAFile }}
  caFile: {{ quote .CAFile }}
{{- else }}
  {{ .Ex }}caFile: /etc/agent/ca.pem
{{- end }}
  # Клиентский сертификат агента (mTLS) — оба файла или ни одного.
  {{ .Ex }}certFile: /etc/agent/agent.crt
  {{ .Ex }}keyFile: /etc/agent/agent.key
  # Пауза переподключения (и повтора регистрации): растёт от min до max.
  {{ .Ex }}reconnect: {min: {{ dur .D.Server.Reconnect.Min }}, max: {{ dur .D.Server.Reconnect.Max }}}
  # Сколько последних status, metrics и log агент держит без связи и досылает.
  {{ .Ex }}streamBuffer: {{ .D.Server.StreamBuffer }}

# Токен регистрации: нужен только при первом подключении, потом агент входит своим ключом.
{{- if .Token }}
enroll:
  token: {{ quote .Token }}
{{- else }}
# Лучше задать переменной AGENT_ENROLL_TOKEN (служба берёт её из agent.env рядом с этим файлом).
{{ .Ex }}enroll:
{{ .Ex }}  token: <токен>
{{- end }}

# Имя агента на сервере (по умолчанию — имя машины) и метки для поиска и отбора.
{{- if .Name }}
name: {{ quote .Name }}
{{- else }}
{{ .Ex }}name: node-01
{{- end }}
{{ .Ex }}labels:
{{ .Ex }}  zone: eu

# Каталог данных: ключ агента, очередь важных сообщений, настройки и сборки воркеров.
{{- if .DataDir }}
dataDir: {{ quote .DataDir }}
{{- else }}
{{ .Ex }}dataDir: {{ quote .D.DataDir }}
{{- end }}

# Лог: level — debug | info | warn | error; format — text | json;
# forward — с какого уровня записи уходят серверу: off | error | warn | info | debug;
# buffer — сколько последних записей агент помнит для agent.logs (на агента и на каждый воркер).
{{- if .LogFormat }}
log:
  format: {{ .LogFormat }}
  {{ .Ex }}level: {{ .D.Log.Level }}
  {{ .Ex }}forward: {{ .D.Log.Forward }}
  {{ .Ex }}buffer: {{ .D.Log.Buffer }}
{{- else }}
{{ .Ex }}log:
{{ .Ex }}  level: {{ .D.Log.Level }}
{{ .Ex }}  format: {{ .D.Log.Format }}
{{ .Ex }}  forward: {{ .D.Log.Forward }}
{{ .Ex }}  buffer: {{ .D.Log.Buffer }}
{{- end }}

# Очередь важных сообщений на диске (события воркеров, итоги): сколько сообщений она держит,
# пока нет связи; полна — новые события воркеров отклоняются.
{{ .Ex }}outbox:
{{ .Ex }}  maxMessages: {{ .D.Outbox.MaxMessages }}

# Обновление: self — агент сам ставит новую версию по команде сервера; external — обновляют
# снаружи (новый образ контейнера); disabled — не обновлять. publicKey и publicKeys — ключи
# проверки подписи сборок (base64): подпись принимается, если сходится с любым; ключ автора
# агента уже вшит в сборки агента, сюда — ключи проекта (его воркеров).
{{ .Ex }}update:
{{ .Ex }}  mode: {{ .D.Update.Mode }}
{{ .Ex }}  publicKeys: [<ключ base64>]

# Метрики узла (их собирает встроенный воркер sysmetrics).
{{ .Ex }}telemetry:
{{ .Ex }}  metrics: [{{ join .D.Telemetry.Metrics ", " }}]
{{ .Ex }}  disks: ["/"]            # точки монтирования для метрик дисков; ["all"] — все
{{ .Ex }}  excludeInterfaces: [{{ join .D.Telemetry.ExcludeInterfaces ", " }}]

# Воркеры: HTTP-сервисы на unix-сокете на любом языке; агент запускает их и держит работающими.
{{- if .Workers }}
workers:
{{- range .Workers }}
  - name: {{ quote .Name }}
{{- if .Release }}
    release: true
{{- end }}
{{- if .Command }}
    command: [{{ commandList .Command }}]
{{- end }}
{{- if .StopTimeout }}
    lifecycle:
      stopTimeout: {{ quote .StopTimeout }}
{{- end }}
{{- end }}
{{- else }}
{{- if not .Uncomment }}
workers: []
{{- end }}
{{ .Ex }}workers:
{{- end }}
{{ .Ex }}  - name: report
{{ .Ex }}    command: ["python3", "/opt/workers/report.py"]
{{ .Ex }}    dir: /opt/workers
{{ .Ex }}    env:
{{ .Ex }}      REPORT_MODE: fast
{{ .Ex }}    inheritEnv: [REPORT_*]  # какие ещё переменные агента передать воркеру
{{ .Ex }}    user: report           # от кого запускать (агенту нужен root)
    # Жизнь воркера; здесь — значения по умолчанию (подходят для долгой работы).
    # Изменение lifecycle, logs и routes применяется без перезапуска воркера.
{{ .Ex }}    lifecycle:
{{ .Ex }}      onAgentExit: {{ .L.OnAgentExit }}      # перезапуск и остановка агента: keep — работает дальше, stop — остановить
{{ .Ex }}      restart: {{ .L.Restart }}   # после выхода процесса: always | on-failure | never
{{ .Ex }}      backoff: {min: {{ dur .L.Backoff.Min }}, max: {{ dur .L.Backoff.Max }}}   # пауза перед перезапуском после падения
{{ .Ex }}      maxRestarts: 0         # падений подряд; 0 — без предела, дальше — остановлен
{{ .Ex }}      startTimeout: {{ dur .L.StartTimeout }}      # сокет должен начать отвечать
{{ .Ex }}      stopTimeout: {{ dur .L.StopTimeout }}       # ждать выхода после SIGTERM, потом SIGKILL
{{ .Ex }}      keepChildren: false    # true — дочерние процессы переживают остановку воркера
{{ .Ex }}      busyTimeout: {{ dur .BusyTimeout }}      # замена ждёт, пока /health отвечает busy: true; 0s — не ждать
{{ .Ex }}      health: {interval: {{ dur .HealthInterval }}, timeout: {{ dur .L.Health.Timeout }}, failures: {{ .HealthFailures }}}   # interval: 0s — не проверять
{{ .Ex }}    logs: {maxSize: {{ .LogMaxSize }}, maxFiles: {{ .LogMaxFiles }}}   # файлы вывода в <dataDir>/logs
{{ .Ex }}    routes: {{ .Routes }}         # strict — запросы сервера только по манифесту воркера; open — любой путь
{{ .Ex }}  - name: example
{{ .Ex }}    release: true          # сборку воркера ставит и обновляет агент (agent install --worker example)
