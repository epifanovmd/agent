{
  "name": "agent-sdk",
  "version": "1.3.1",
  "description": "Серверная часть связи с агентами для Node.js: регистрация, WebSocket, запросы к воркерам, настройки, метрики, события, раздача сборок",
  "keywords": [
    "agent",
    "sdk",
    "websocket",
    "node-agent"
  ],
  "homepage": "https://github.com/epifanovmd/agent/blob/main/sdk/README.md",
  "bugs": {
    "url": "https://github.com/epifanovmd/agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epifanovmd/agent.git",
    "directory": "sdk/node"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "lru-cache": "^11.5.3",
    "semver": "^7.8.5",
    "ws": "^8.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.1",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1"
  }
}
