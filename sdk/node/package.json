{
  "name": "agent-sdk",
  "version": "1.1.0",
  "description": "SDK агента для Node.js: воркер на узле (agent-sdk/worker) и серверная часть (agent-sdk/server)",
  "keywords": [
    "agent",
    "worker",
    "sdk",
    "websocket",
    "jobs",
    "node-agent"
  ],
  "homepage": "https://github.com/epifanovmd/agent/blob/main/sdk/README.md",
  "bugs": {
    "url": "https://github.com/epifanovmd/agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epifanovmd/agent.git",
    "directory": "sdk/node"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "eslint .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1"
  }
}
