  "worker.manifest": {
    "from": "agent",
    "to": "worker",
    "request": {
      "method": "GET",
      "path": "/manifest"
    },
    "response": {
      "status": 200,
      "body": {
        "version": "1.4.0",
        "description": "Отправка отчётов",
        "configs": [
          {
            "key": "main",
            "description": "Куда и как часто отправлять",
            "schema": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string"
                },
                "intervalSec": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": ["target"],
              "additionalProperties": false
            }
          },
          {
            "key": "limits",
            "description": "Пределы очереди"
          }
        ],
        "routes": [
          {
            "method": "GET",
            "path": "/reports",
            "description": "Список отчётов"
          },
          {
            "method": "POST",
            "path": "/reports/{id}/send",
            "description": "Отправить отчёт сейчас"
          }
        ],
        "events": [
          {
            "type": "report.sent",
            "description": "Отчёт отправлен"
          }
        ],
        "jobs": [
          {
            "type": "report.build",
            "description": "Собрать отчёт за период",
            "schema": {
              "type": "object",
              "properties": {
                "days": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          {
            "type": "report.check",
            "description": "Проверить источник отчётов"
          }
        ]
      }
    }
  },
